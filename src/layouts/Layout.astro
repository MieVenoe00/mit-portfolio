---
import '../styles/global.css';
const { title } = Astro.props;
---


<!doctype html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favikon.svg" />
    <link rel="icon" href="/favicon.svg" />
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Roboto+Mono:ital,wght@0,100..700;1,100..700&display=swap" rel="stylesheet">
    <meta name="generator" content={Astro.generator} />
    <title>Mie Venø Skjærbæk //{title}</title>   
  </head>
  <body>
    <header class="absolute top-8 left-10 z-10">
      <a href="/">
        <h1 id="headOverskrift" class="text-[#d17326] text-3xl font-bold">Mie Venø Skjærbæk</h1>
      </a>
      <p id="sideTag" class="text-[#d17326] text-lg">//{title}</p>
    </header>
    <slot />
  </body>
</html>

<style>
  html, body {
    margin: 0;
    width: 100%;
    height: 100%;
    background-color: #f0ede8;
  }

</style>