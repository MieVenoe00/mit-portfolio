---
import Layout from "../layouts/Layout.astro";
import { readFileSync } from 'fs';
import { resolve } from 'path';

const contactinfo = readFileSync(resolve('public/contactinfo.svg'), 'utf-8');
const contactplatform = readFileSync(resolve('public/contactplatform.svg'), 'utf-8');
---

<Layout title="Kontakt mig">
  <main class="flex items-center justify-center w-full min-h-screen overflow-hidden">
    <section  class="flex items-center justify-center w-[80%] h-full gap-40">
      <div set:html={contactplatform}  class="w-full"/>
      <div set:html={contactinfo} class="w-full mt-38" />
    </section>
  </main>
  <script>
  document.getElementById('mailgroup').addEventListener('click', () => {
    window.location.href = 'mailto:mie.venoe@outlook.com';
  });

  document.getElementById('mailgroup').style.cursor = 'pointer';

  document.getElementById('linkedingroup').addEventListener('click', () => {
  window.open('https://www.linkedin.com/in/mie-ven%C3%B8-skj%C3%A6rb%C3%A6k/', '_blank');
});

  document.getElementById('linkedingroup').style.cursor = 'pointer';


  document.getElementById('phonegroup').addEventListener('click', () => {
  const phone = '+4541984154';
  
  if (/Mobi|Android/i.test(navigator.userAgent)) {
    // Mobil: ring op
    window.location.href = `tel:${phone}`;
  } else {
    // Desktop: kopier til clipboard
    navigator.clipboard.writeText(phone).then(() => {
      alert('Telefonnummer kopieret!');
    });
  }
});

document.getElementById('phonegroup').style.cursor = 'pointer';
</script>
</Layout>