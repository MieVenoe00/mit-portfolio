---
import Layout from "../layouts/Layout.astro";
import { readFileSync } from 'fs';
import { resolve } from 'path';

function prefixSvgIds(svgContent: string, prefix: string): string {
  // Erstat id="..." definitioner
  let result = svgContent.replace(/id="([^"]+)"/g, `id="${prefix}-$1"`);
  // Erstat url(#...) referencer
  result = result.replace(/url\(#([^)]+)\)/g, `url(#${prefix}-$1)`);
  // Erstat xlink:href="#..." og href="#..." referencer
  result = result.replace(/(xlink:href|href)="#([^"]+)"/g, `$1="#${prefix}-$2"`);
  return result;
}

const aaben = prefixSvgIds(readFileSync(resolve('./public/aabencase.svg'), 'utf-8'), 'aaben');
const iltsvind = prefixSvgIds(readFileSync(resolve('./public/iltsvindcase.svg'), 'utf-8'), 'iltsvind');
const koln = prefixSvgIds(readFileSync(resolve('./public/kolncase.svg'), 'utf-8'), 'koln');
---

<Layout title="Cases">

  <main class=" cases-wrapper flex items-center justify-center w-full min-h-screen overflow-hidden">
  


    <article class="case-card case-left">
      <div class="case-platform" set:html={aaben} />
    </article>

    <article class="case-card case-right">
      <div class="case-platform" set:html={iltsvind} />
    </article>

    <article class="case-card case-left">
      <div class="case-platform" set:html={koln} />
    </article>



   
  </main>

  <script>
    const caseCards = document.querySelectorAll('.case-card');
    caseCards.forEach(card => {
      card.addEventListener('click', () => {
        card.classList.toggle('expanded');
      });
    });

    
    // Casebutton animation 
   document.querySelectorAll('[id$="-casebutton"]').forEach(button => {
  const prefix = button.id.replace('-casebutton', '');
  const innerGroup = document.getElementById(`${prefix}-innercircle`);

  if (!innerGroup) return;

  const innerEllipse = innerGroup.querySelector('ellipse');
  if (!innerEllipse) return;

  const origRx = parseFloat(innerEllipse.getAttribute('rx'));
  const origRy = parseFloat(innerEllipse.getAttribute('ry'));

  innerEllipse.style.transition = 'rx 0.3s ease, ry 0.3s ease';

  // Cursor og link
  button.style.cursor = 'pointer';
  button.addEventListener('click', () => {
    window.location.href = `/${prefix}case`;
  });

  button.addEventListener('mouseenter', () => {
    innerEllipse.style.rx = (origRx * 1.9) + 'px';
    innerEllipse.style.ry = (origRy * 1.9) + 'px';
  });

  button.addEventListener('mouseleave', () => {
    innerEllipse.style.rx = origRx + 'px';
    innerEllipse.style.ry = origRy + 'px';
  });
});
  </script>
</Layout>