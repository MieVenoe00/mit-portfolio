---
import CaseLayout from "../layouts/CaseLayout.astro"
import CaseIntro from "../components/CaseIntro.astro"
import CaseGallari from "../components/CaseGallari.astro"
import FlexComponents from "../components/FlexComponents.astro"
import LinkKnap from "../components/LinkKnap.astro"

import heroImg from "../assets/aabenbillederorange.svg";
import pictureEt from "../assets/labelbillede1.svg";
import pictureTo from "../assets/labelbillede2.svg";
import generator from "../assets/aabengenerator.png";

---

<CaseLayout title="ÅBEN Bryggeri">

  <main class="flex flex-col items-center gap-20 lg:gap-30 mb-20  w-full min-h-screen ">
    <section class="mt-[15rem]">
    <CaseIntro >
      <img slot="intropic" src={heroImg.src} alt="">
      <h2 slot="introOverskrift" class="font-bold text-[#d17326] text-xl" >ÅBEN Bryggeri Labelgenerator</h2>
      <h4 slot="introtekst"> ÅBEN er et dansk craft brewery med et stort fokus på eksperimenterende øl og hyppige lanceringer, hvilket skaber et behov for hurtig og konsistent produktion af visuelt materiale. <br> <br>

        I denne opgave designede og kodede jeg et generativt label-værktøj i p5.js, hvor øllens egne smagsnoter automatisk styrer farverne på etiketten gennem et datadrevet gradientsystem. <br>
        </h4>
        <LinkKnap  href="https://aben-beer-label.netlify.app/">
  Åben Labelgenerator
</LinkKnap></div>
    
    </CaseIntro> </section>
  
   <CaseGallari>
  <img slot="picture1" src={pictureEt.src} />
  <img slot="picture2" src={pictureTo.src} />
</CaseGallari>
<FlexComponents>
      <img slot="flexBillede" src={generator.src} />
      <h2 slot="flexOverskrift" class="font-bold text-[#d17326] text-xl" >Label Generatoren</h2>
      <h4 slot="flexTekst"> Generatoren skaber organiske, støjforvrængede former, mens designeren stadig har kreativ kontrol over komposition og rytme via intuitive sliders. <br>
        Ølstilarten påvirker desuden automatisk tema, kontrast og blend modes, så designet tilpasser sig øllets karakter uden at miste ÅBENs visuelle identitet. <br><br>

        Løsningen gør det muligt hurtigt at producere unikke labels til et konstant voksende katalog af øl, samtidig med at designprocessen forbliver konsistent og brugervenlig. </h4>
</FlexComponents>
<div class="flex justify-center items-start w-[80%] overflow-hidden h-[50rem]">
  <iframe
    title="Inline Frame Example"
    class="origin-top"
    style="transform: scale(0.7); width: calc(100% / 0.7); height: calc(100% / 0.7);"
    src="https://aben-beer-label.netlify.app/">
  </iframe>
</div>

    

  </main>
</CaseLayout>