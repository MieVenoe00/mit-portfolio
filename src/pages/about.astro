---
import Layout from "../layouts/Layout.astro";
import { readFileSync } from 'fs';
import { resolve } from 'path';
import LinkKnap from "../components/LinkKnap.astro"


import mypicture from "../assets/mypicture.svg";

---

<Layout title="Om Mig">

  <main class="cases-wrapper flex items-center justify-center w-full min-h-screen overflow-hidden">
    <section class="flex flex-col lg:flex-row items-center justify-center gap-15 lg:gap-10 w-[80%] 3xl:w-[70%] overflow-hidden ">
      <div class="w-[95%] sm:w-[70%]  lg:basis-[40%] 2xl:basis-[40%] 3xl:basis-[40%] relative group">
        <img src="/mydrawing2.svg" alt="" class="w-full h-auto transition-opacity duration-500 group-hover:opacity-0">
        <img src={mypicture.src} alt="" class="w-full h-auto absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100">
      </div>
      <div>
        <h2 class="font-bold text-[#d17326] text-base sm:text-lg lg:text-lg xl:text-xl 2xl:text-2xl 3xl:text-3xl" >
          Om Mig</h2>
        <p class="text-sm sm:text-base md:text-base lg:text-base xl:text-xl 2xl:text-xl 3xl:text-2xl mt-6">
          En kort intro om min</p>
      </div>
    </section>

    <section class="flex flex-col lg:flex-row items-center justify-center mt-[10rem] gap-15 lg:gap-10 w-[80%] 3xl:w-[70%] overflow-hidden" >
      <div class="w-[90%] sm:w-lg md:w-xl lg:w-[70%] xl:w-[60%] 2xl:w-[60%] 3xl:w-[60%] h-auto">
          <img src="/CVlayout2.svg" alt="">
      </div>
    </section>

    <section>
      <LinkKnap href="/MitCV.pdf" download="MieVenoSkjaerbaek_CV.pdf" class="mt-[5rem]">
        Download mit CV
      </LinkKnap>
    </section>

  </main>

  <script>
    
  </script>

</Layout>